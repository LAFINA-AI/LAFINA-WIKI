---
---

<section class="hero-section">
  <!-- Animated background grid -->
  <div class="hero-grid" aria-hidden="true"></div>

  <!-- Waveform animation -->
  <div class="waveform-container" aria-hidden="true">
    {Array.from({ length: 20 }).map((_, i) => (
      <div 
        class="waveform-bar" 
        style={`--bar-delay: ${(i * 0.08).toFixed(2)}s; --bar-height: ${30 + Math.sin(i * 0.8) * 25 + Math.random() * 20}px;`}
      />
    ))}
  </div>

  <div class="hero-content">
    <!-- Badge -->
    <div class="hero-badge">
      <span class="badge-dot"></span>
      Capstone Research Project · USTP CDO
    </div>

    <!-- Title -->
    <h1 class="hero-title">
      <span class="hero-lafina">LAFINA</span>
    </h1>

    <!-- Subtitle -->
    <p class="hero-subtitle">
      A voice-first AI scheduler that <em>calls you</em>, not the other way around.
    </p>

    <!-- Full title -->
    <p class="hero-full-title">
      A Conversational Interface for Enhanced Schedule Adherence:<br/>
      NLP-Driven Development of an Automated Voice-Call Reminder System
    </p>

    <!-- CTA Buttons -->
    <div class="hero-actions">
      <a href="/problem-and-goals" class="btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 16v-4M12 8h.01"/>
        </svg>
        Explore the Research
      </a>
      <a href="/ai-models" class="btn-secondary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
          <path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/>
        </svg>
        View AI Models
      </a>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    overflow: hidden;
    border-radius: 1.25rem;
    padding: 4rem 2rem 3.5rem;
    margin-bottom: 3rem;
    background: linear-gradient(135deg, 
      color-mix(in srgb, #4f46e5 12%, var(--color-background)),
      color-mix(in srgb, #7c3aed 8%, var(--color-background)),
      color-mix(in srgb, #0ea5e9 6%, var(--color-background))
    );
    border: 1px solid color-mix(in srgb, #4f46e5 20%, transparent);
    text-align: center;
  }

  /* Subtle dot grid */
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, color-mix(in srgb, #4f46e5 20%, transparent) 1px, transparent 1px);
    background-size: 28px 28px;
    opacity: 0.4;
    pointer-events: none;
  }

  /* Waveform */
  .waveform-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    height: 60px;
    margin-bottom: 2rem;
    position: relative;
    z-index: 1;
  }

  .waveform-bar {
    width: 4px;
    border-radius: 999px;
    background: linear-gradient(to top, #4f46e5, #7c3aed);
    animation: waveform 1.4s ease-in-out infinite alternate;
    animation-delay: var(--bar-delay, 0s);
    height: var(--bar-height, 20px);
    opacity: 0.8;
  }

  @keyframes waveform {
    0% {
      transform: scaleY(0.3);
      opacity: 0.4;
    }
    100% {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 20%, transparent);
    border-radius: 999px;
    padding: 0.3rem 1rem;
    margin-bottom: 1.5rem;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary);
    animation: badgePulse 2s ease-in-out infinite;
  }

  @keyframes badgePulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .hero-title {
    margin: 0 0 0.75rem;
    font-size: clamp(3.5rem, 10vw, 6rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .hero-lafina {
    background: linear-gradient(135deg, #4f46e5, #7c3aed, #0ea5e9);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    color: var(--color-text);
    font-weight: 500;
    margin: 0 0 0.75rem;
    opacity: 0.9;
  }

  .hero-subtitle em {
    font-style: normal;
    color: var(--color-primary);
    font-weight: 700;
  }

  .hero-full-title {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin: 0 0 2rem;
    line-height: 1.6;
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.5rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    background: var(--color-primary);
    color: white;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
    box-shadow: 0 4px 14px color-mix(in srgb, var(--color-primary) 40%, transparent);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px color-mix(in srgb, var(--color-primary) 50%, transparent);
    opacity: 0.95;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.5rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    color: var(--color-primary);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--color-primary) 30%, transparent);
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .btn-secondary:hover {
    transform: translateY(-2px);
    background: color-mix(in srgb, var(--color-primary) 15%, transparent);
  }
</style>
