---
interface Props {
  variant?: 'default' | 'primary' | 'success' | 'warning' | 'danger';
}

const { variant = 'default' } = Astro.props;

const styles = {
  default: 'bg-muted/10 text-muted border-muted/20',
  primary: 'bg-primary/10 text-primary border-primary/20',
  success: 'bg-green-500/10 text-green-500 border-green-500/20',
  warning: 'bg-yellow-500/10 text-yellow-500 border-yellow-500/20',
  danger: 'bg-red-500/10 text-red-500 border-red-500/20',
};
---

<span class={`inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 ${styles[variant]}`}>
  <slot />
</span>
