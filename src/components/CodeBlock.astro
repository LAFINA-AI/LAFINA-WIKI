---
interface Props {
  language?: string;
  title?: string;
}
const { language = 'text', title } = Astro.props;
---
<div class="my-6 rounded-lg overflow-hidden border border-muted/20 bg-surface shadow-sm not-prose">
  {title && (
    <div class="flex items-center px-4 py-2 border-b border-muted/20 bg-background/50 text-sm text-muted font-mono">
      <span>{title}</span>
    </div>
  )}
  <div class="relative">
    <div class="absolute right-4 top-4 text-xs font-mono text-muted/50 uppercase select-none">{language}</div>
    <div class="p-4 overflow-x-auto text-sm text-text font-mono bg-surface">
      <slot />
    </div>
  </div>
</div>
