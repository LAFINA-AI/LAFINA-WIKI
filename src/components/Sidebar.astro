---
import { navigation } from '../data/navigation';
const groups = navigation;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<aside class="hidden lg:block sticky top-16 shrink-0 w-64 h-[calc(100vh-4rem)] overflow-y-auto border-r border-muted/20 py-10 pr-6">
  <nav class="text-sm leading-6 relative" aria-label="Wiki navigation">
    <ul>
      {groups.map((group) => (
        <li class="mt-8 first:mt-0">
          <h2 class="mb-3 font-semibold text-text text-xs uppercase tracking-wider opacity-60">{group.label}</h2>
          <ul class="space-y-1 border-l border-muted/20">
            {group.links.map((link) => {
              const isActive = pathname === link.href || pathname === link.href + '/';
              return (
                <li>
                  <a
                    class={`block border-l -ml-px transition-colors pl-4 py-0.5 ${isActive ? 'border-primary text-primary font-medium' : 'border-transparent hover:border-muted text-text/70 hover:text-text'}`}
                    href={link.href}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    {link.text}
                  </a>
                </li>
              );
            })}
          </ul>
        </li>
      ))}
    </ul>
  </nav>
</aside>
