---
/**
 * One practice question. The answer stays hidden until the reader opens it,
 * so the page works like flashcards: try answering out loud first, then check.
 */
interface Props {
  q: string;
  tip?: string;
  level?: 'basic' | 'deeper' | 'curveball';
}
const { q, tip, level = 'basic' } = Astro.props;
const levelText = { basic: 'Basic', deeper: 'Deeper', curveball: 'Curveball' }[level];
---

<details class={`pq pq-${level}`}>
  <summary>
    <span class="pq-level">{levelText}</span>
    <span class="pq-q">{q}</span>
    <span class="pq-hint" aria-hidden="true">Show answer</span>
  </summary>
  <div class="pq-body">
    <div class="pq-answer"><slot /></div>
    {tip && <p class="pq-tip"><strong>Key point:</strong> {tip}</p>}
  </div>
</details>

<style>
  .pq {
    --tone: var(--color-primary);
    margin: 0.75rem 0;
    border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
    border-left: 4px solid var(--tone);
    border-radius: 0.6rem;
    background: var(--color-surface);
  }
  .pq-deeper { --tone: #0891b2; }
  .pq-curveball { --tone: #d97706; }
  summary {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.8rem 1rem;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  .pq-level {
    flex-shrink: 0;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tone);
  }
  .pq-q { flex: 1; font-weight: 600; color: var(--color-text); }
  .pq-hint {
    flex-shrink: 0;
    font-size: 0.72rem;
    color: var(--color-primary);
  }
  .pq[open] .pq-hint { visibility: hidden; }
  .pq-body {
    padding: 0 1rem 0.9rem;
    border-top: 1px dashed color-mix(in srgb, var(--color-text) 12%, transparent);
  }
  .pq-answer :global(p) { margin: 0.7rem 0 0; }
  .pq-answer :global(ul) { margin: 0.5rem 0 0; }
  .pq-tip {
    margin: 0.8rem 0 0 !important;
    padding: 0.5rem 0.75rem;
    font-size: 0.85rem;
    border-radius: 0.4rem;
    background: color-mix(in srgb, var(--tone) 10%, transparent);
  }
</style>
