---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Sidebar from '../components/Sidebar.astro';

const { frontmatter, title: propTitle } = Astro.props;
const title = frontmatter?.title || propTitle || "LAFINA Wiki";
const description = frontmatter?.description || Astro.props.description || "LAFINA — A Conversational Interface for Enhanced Schedule Adherence. NLP-driven automated voice-call reminder system for university students.";
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://lafina-wiki.vercel.app');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{title === "Introduction" ? "LAFINA Wiki — Voice-Call AI Reminder System" : `${title} — LAFINA Wiki`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title === "Introduction" ? "LAFINA Wiki" : `${title} — LAFINA Wiki`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="LAFINA Wiki" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title === "Introduction" ? "LAFINA Wiki" : `${title} — LAFINA Wiki`} />
    <meta name="twitter:description" content={description} />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Browser UI color (mobile address bar); kept in sync with the theme below -->
    <meta name="theme-color" content="#ffffff" />

    <!-- Prevent FOUC for dark mode -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (
          localStorage.getItem('theme') === 'dark' ||
          (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          root.classList.add('dark');
        } else {
          root.classList.remove('dark');
        }
        // Keep native UI (scrollbars, form controls, mobile browser bar) in step with the theme,
        // including when the theme toggle switches it later.
        var sync = function () {
          var dark = root.classList.contains('dark');
          root.style.colorScheme = dark ? 'dark' : 'light';
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', dark ? '#0f172a' : '#ffffff');
        };
        sync();
        new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ['class'] });
      })();
    </script>
  </head>
  <body class="bg-background text-text antialiased min-h-screen flex flex-col">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Navbar />
    <div class="max-w-[90rem] mx-auto w-full flex flex-1 items-start px-4 sm:px-6 lg:px-8">
      <Sidebar />
      <main id="main-content" class="flex-1 min-w-0 py-10 lg:pl-10">
        <div class="max-w-4xl mx-auto pb-24">
          <article class="prose prose-slate dark:prose-invert max-w-none prose-headings:text-text prose-p:text-text prose-a:text-primary hover:prose-a:text-accent prose-strong:text-text prose-code:text-accent prose-code:bg-surface prose-code:rounded prose-code:px-1 prose-code:py-0.5 prose-pre:bg-surface prose-pre:border prose-pre:border-muted/20">
            {frontmatter?.title && <h1 class="mb-8 font-extrabold tracking-tight text-3xl sm:text-4xl">{frontmatter.title}</h1>}
            <slot />
          </article>
        </div>
      </main>
    </div>
  </body>
</html>
