---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Sidebar from '../components/Sidebar.astro';

const { frontmatter, title: propTitle } = Astro.props;
const title = frontmatter?.title || propTitle || "LAFINA Wiki";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Prevent FOUC for dark mode -->
    <script is:inline>
      if (
        localStorage.getItem('theme') === 'dark' ||
        (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)
      ) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-background text-text antialiased min-h-screen flex flex-col">
    <Navbar />
    <div class="max-w-[90rem] mx-auto w-full flex flex-1 items-start px-4 sm:px-6 lg:px-8">
      <Sidebar />
      <main class="flex-1 min-w-0 py-10 lg:pl-10">
        <div class="max-w-4xl mx-auto pb-24">
          <article class="prose prose-slate dark:prose-invert max-w-none prose-headings:text-text prose-p:text-text prose-a:text-primary hover:prose-a:text-accent prose-strong:text-text prose-code:text-accent prose-code:bg-surface prose-code:rounded prose-code:px-1 prose-code:py-0.5 prose-pre:bg-surface prose-pre:border prose-pre:border-muted/20">
            {frontmatter?.title && <h1 class="mb-8 font-extrabold tracking-tight text-3xl sm:text-4xl">{frontmatter.title}</h1>}
            <slot />
          </article>
        </div>
      </main>
    </div>
  </body>
</html>
