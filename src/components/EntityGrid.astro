---
/**
 * A simple, readable "ERD-lite": each database table as a card with its key columns.
 * `key` columns are primary keys, `fk` columns are declared foreign keys.
 */
interface Field { name: string; note?: string; key?: boolean; fk?: boolean }
interface Entity { name: string; about?: string; fields: Field[]; tone?: string }
interface Props { entities: Entity[]; caption?: string }
const { entities, caption } = Astro.props;
---

<figure class="entity-grid not-prose">
  <div class="eg-cards">
    {entities.map((e) => (
      <div class="eg-card" style={`--tone: ${e.tone ?? 'var(--color-primary)'}`}>
        <div class="eg-head">
          <code>{e.name}</code>
          {e.about && <span>{e.about}</span>}
        </div>
        <ul>
          {e.fields.map((f) => (
            <li>
              <code>{f.name}</code>
              {f.key && <b class="eg-tag eg-pk">PK</b>}
              {f.fk && <b class="eg-tag eg-fk">FK</b>}
              {f.note && <em>{f.note}</em>}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .entity-grid { margin: 1.75rem 0; }
  .eg-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(14.5rem, 1fr)); gap: 0.85rem; }
  .eg-card {
    border: 1px solid color-mix(in srgb, var(--tone) 35%, transparent);
    border-radius: 0.65rem;
    overflow: hidden;
    background: var(--color-surface);
  }
  .eg-head {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.55rem 0.8rem;
    background: color-mix(in srgb, var(--tone) 14%, var(--color-background));
    border-bottom: 1px solid color-mix(in srgb, var(--tone) 30%, transparent);
  }
  .eg-head code { font-weight: 700; font-size: 0.85rem; color: var(--color-text); }
  .eg-head span { font-size: 0.72rem; color: color-mix(in srgb, var(--color-text) 70%, transparent); }
  ul { list-style: none; margin: 0; padding: 0.4rem 0.8rem 0.6rem; }
  li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.35rem; padding: 0.18rem 0; font-size: 0.78rem; color: var(--color-text); }
  li code { font-size: 0.76rem; }
  li em { font-style: normal; font-size: 0.7rem; color: color-mix(in srgb, var(--color-text) 62%, transparent); }
  .eg-tag { font-size: 0.6rem; padding: 0 0.3rem; border-radius: 0.25rem; letter-spacing: 0.04em; }
  .eg-pk { background: color-mix(in srgb, #d97706 20%, transparent); color: #b45309; }
  .eg-fk { background: color-mix(in srgb, #0891b2 20%, transparent); color: #0e7490; }
  :global(.dark) .eg-pk { color: #fbbf24; }
  :global(.dark) .eg-fk { color: #67e8f9; }
  figcaption { margin-top: 0.75rem; font-size: 0.75rem; color: color-mix(in srgb, var(--color-text) 65%, transparent); text-align: center; }
</style>
